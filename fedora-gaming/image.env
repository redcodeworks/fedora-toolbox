# Optional per-image metadata (the image name is the directory name unless IMAGE_NAME is set here).
IMAGE_DESC="Gaming toolbox for distrobox: Steam, gamescope, MangoHud, GameMode on Fedora's Mesa"
# The context is the repository root: the list lives in gaming-packages/, the installer in package-installer/;
# a change there rebuilds this image.
BUILD_CONTEXT=.
EXTRA_PATHS=gaming-packages package-installer
