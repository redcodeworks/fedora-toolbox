# Build context is mounted, not copied into the final image. The context is the repository root (BUILD_CONTEXT=. in
# image.env): the list is shared with the published gaming-packages image, the installer with every manifest image.
FROM scratch AS ctx
COPY fedora-gaming/build_files /build_files
COPY gaming-packages/gaming.txt package-installer/install.sh /gaming-packages/

# Base: Universal Blue's toolbox (github.com/ublue-os/toolboxes), Fedora 44, moving `latest` tag
# only. Renovate pins the digest. Terra is dropped on purpose in build.sh (see CLAUDE.md).
FROM ghcr.io/ublue-os/fedora-toolbox:latest

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    bash /ctx/build_files/build.sh

# Labels are set after the build step so changing the build args does not invalidate the build cache.
# They are explicit so nothing from the base is republished (no inherited maintainer email).
LABEL maintainer="redcodeworks/fedora-toolbox" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="fedora-gaming" \
      org.opencontainers.image.description="Gaming toolbox for distrobox: Steam, gamescope, MangoHud, GameMode on Fedora's Mesa (Terra dropped)" \
      org.opencontainers.image.url="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.documentation="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.source="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="ghcr.io/ublue-os/fedora-toolbox:latest" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
