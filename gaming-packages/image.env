# Data image, not a toolbox: FROM scratch, the fedora-gaming package list and the shared installer (see README.md).
IMAGE_NAME=gaming-packages
IMAGE_DESC="Package manifest of fedora-gaming and its installer"
IMAGE_KIND=list
BUILD_CONTEXT=.
EXTRA_PATHS=package-installer
DATA_FILES="gaming-packages/gaming.txt:gaming.txt package-installer/install.sh:install.sh gaming-packages/README.md:README"
IMAGE_SCHEDULE=false
