# Data image, not a toolbox: FROM scratch, the gaming package lists and the shared installers (see README.md).
IMAGE_NAME=gaming-packages
IMAGE_DESC="Gaming package lists (Fedora, negativo17, COPR) and installers shared by fedora-gaming and octarine-os-gx"
IMAGE_KIND=list
BUILD_CONTEXT=.
EXTRA_PATHS=package-installer
DATA_FILES="gaming-packages/fedora.txt:fedora.txt gaming-packages/negativo17.txt:negativo17.txt gaming-packages/copr.txt:copr.txt package-installer/install.sh:install.sh package-installer/install-copr.sh:install-copr.sh gaming-packages/README.md:README"
IMAGE_SCHEDULE=false
