# Published as ghcr.io/redcodeworks/gaming-packages: the gaming package lists (Fedora, RPM Fusion,
# COPR) and their installers, nothing else. No base image, no shell, no packages. fedora-gaming builds from the same in-repo files.
# Build context: the repository root.
FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY gaming-packages/fedora.txt gaming-packages/rpmfusion.txt gaming-packages/copr.txt package-installer/install-copr.sh package-installer/install.sh /
COPY gaming-packages/README.md /README

LABEL maintainer="redcodeworks/fedora-toolbox" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="gaming-packages" \
      org.opencontainers.image.description="Gaming package lists (Fedora, RPM Fusion, COPR) and installers shared by fedora-gaming and octarine-os-gx" \
      org.opencontainers.image.url="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.documentation="https://github.com/redcodeworks/fedora-toolbox/blob/main/gaming-packages/README.md" \
      org.opencontainers.image.source="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
