# Data image, not a toolbox: FROM scratch, the lakehouse datastore bundle (see README.md).
IMAGE_NAME=datastore-images
IMAGE_DESC="Lakehouse datastore bundle: pinned container images (PostgreSQL, Valkey, SeaweedFS, Kafka), Quadlet templates, the datastore command"
IMAGE_KIND=list
BUILD_CONTEXT=.
# images.txt is validated by validate.sh (lint and tests), not by the package-list rules.
LIST_VALIDATOR=datastore-images/validate.sh
# Files the image must carry, checked against the repository by the build: <repo path>:<path in the image>
# (a directory stands for every file in it, so a new Quadlet or script needs no entry here)
DATA_FILES="datastore-images/images.txt:images.txt datastore-images/README.md:README datastore-images/bin:bin datastore-images/lib:lib datastore-images/quadlets:quadlets"
# A script the build runs against the files extracted from the BUILT image, before it is published (given the directory).
DATA_CHECK=datastore-images/check-bundle.sh
# The weekly schedule does not rebuild it: a rebuild only changes the created label, so the digest
# consumers pin would change for no reason; changes and manual runs do.
IMAGE_SCHEDULE=false
