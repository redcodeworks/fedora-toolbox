# Data image, not a toolbox: FROM scratch, the pinned datastore container images (see README.md).
IMAGE_NAME=datastore-images
IMAGE_DESC="Pinned container images of the lakehouse datastore (PostgreSQL, Valkey, SeaweedFS, Kafka)"
IMAGE_KIND=list
BUILD_CONTEXT=.
# The file is validated by validate.sh (lint and tests), not by the package-list rules.
LIST_VALIDATOR=datastore-images/validate.sh
# Files the image must carry, checked against the repository by the build: <repo path>:<path in the image>
DATA_FILES="datastore-images/images.txt:images.txt datastore-images/README.md:README"
# The weekly schedule does not rebuild it: a rebuild only changes the created label, so the digest
# consumers pin would change for no reason; changes and manual runs do.
IMAGE_SCHEDULE=false
