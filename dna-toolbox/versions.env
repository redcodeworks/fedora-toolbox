# The version pins of dna-toolbox, in one place. Plain shell, sourced (never executed) by
# build_files/build.sh, the dna-setup, dna-lab and dna-doctor commands and /etc/profile.d/dna-toolbox.sh,
# and the welcome notebooks read the exported values. Every value can be overridden from the
# environment (for example `DNA_PYTHON_VERSION=3.13 dna-setup`); the DNA_ prefix marks the variables
# that control this container.
#
# Reference target: Databricks Runtime 18 LTS (released 2026-06-10, end of support 2029-06-10).
# Per Kevin's notes it bundles Spark 4.1.0, Scala 2.13.16, Java 21 (Zulu), Python 3.12.3, Delta Lake
# 4.2.0, R 4.5.1 (informational only, R is not installed here) and hadoop-client-runtime 3.4.2.
# This box mirrors those versions for local development; it cannot reproduce Databricks-only
# features such as Photon or Unity Catalog. Spark here is 4.1.1 (the SDKMAN default), one patch
# release above DBR's 4.1.0.
#
# UNVERIFIED: whether the Spark 4.1.x binary distribution ships Hadoop 3.4.x client jars, and which
# versions the SDKMAN `hadoop` and `spark` candidates offer (check with `sdk list hadoop` in a box).

export DNA_DBR_VERSION="${DNA_DBR_VERSION:-18}"
export DNA_SPARK_VERSION="${DNA_SPARK_VERSION:-4.1.1}"
export DNA_SCALA_VERSION="${DNA_SCALA_VERSION:-2.13}"
export DNA_JAVA_VERSION="${DNA_JAVA_VERSION:-21}"
export DNA_PYTHON_VERSION="${DNA_PYTHON_VERSION:-3.12}"
export DNA_HADOOP_VERSION="${DNA_HADOOP_VERSION:-3.4.2}"
export DNA_DELTA_VERSION="${DNA_DELTA_VERSION:-4.2.0}"
export DNA_R_VERSION="${DNA_R_VERSION:-4.5.1}"
