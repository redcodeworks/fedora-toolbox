#!/usr/bin/env bash
# dna-stack: deploy the lakehouse and AI server containers on the HOST from inside the toolbox.
#
# The toolbox keeps clients and dev tools; the servers run as host containers. This script renders
# Quadlet files (podman with systemd --user) or compose files (podman compose / docker compose) and
# drives the host runtime through distrobox-host-exec (distrobox) or flatpak-spawn --host (Fedora
# toolbox). Everything is off until you pick it (`setup`); destructive steps are a dry run unless
# --yes is given. Run `dna-stack help`.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${DNA_STACK_ROOT:-/usr/share/dna-stack}
[[ -f "${ROOT}/stack.env" ]] || ROOT=$(cd "$(dirname "${SELF}")/.." && pwd)
# shellcheck source=/dev/null
source "${ROOT}/stack.env"

STATE=${DNA_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/dna-stack}
QUADLET_DIR=${DNA_QUADLET_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/containers/systemd}
HEADER='# Generated by dna-stack'
NETWORK=dna-stack

say() { printf '%s\n' "$*"; }
die() { printf 'dna-stack: %s\n' "$*" >&2; exit 1; }
undo() { printf '    undo: %s\n' "$*"; }

# ---------------------------------------------------------------- catalog

catalog_names() { awk -F'|' '!/^#/ && NF >= 4 {print $1}' "${ROOT}/catalog.tsv"; }
catalog_field() { awk -F'|' -v n="$1" -v f="$2" '$1 == n {print $f}' "${ROOT}/catalog.tsv"; }
tier_of() { catalog_field "$1" 2; }
deps_of() { catalog_field "$1" 3 | tr ',' ' '; }
summary_of() { catalog_field "$1" 4; }
shipped() { [[ "$(tier_of "$1")" == "slice" ]]; }
known() { [[ -n "$(tier_of "$1")" ]]; }

# Selected services plus their dependencies, in start order (dependencies first)
closure() {
    local -a order=()
    local n d
    add() {
        local x=$1 seen
        for seen in "${order[@]:-}"; do [[ "${seen}" == "${x}" ]] && return 0; done
        for d in $(deps_of "${x}"); do add "${d}"; done
        order+=("${x}")
    }
    for n in "$@"; do add "${n}"; done
    printf '%s\n' "${order[@]:-}"
}

selected() { [[ -f "${STATE}/selected" ]] && cat "${STATE}/selected" || true; }
is_selected() { selected | grep -qx "$1"; }

# ---------------------------------------------------------------- images and ports

lockfile() { if [[ -f "${STATE}/images.lock" ]]; then echo "${STATE}/images.lock"; else echo "${ROOT}/images.lock"; fi; }
image_ref() {
    awk -F'|' -v n="$1" '!/^#/ && $1 == n { if ($3 != "") print $2 "@" $3; else print $2 }' "$(lockfile)"
}
port_key() { case "$1" in seaweedfs) echo SEAWEEDFS_S3 ;; *) printf '%s' "${1^^}" ;; esac; }
host_port() {
    local key base
    key=$(port_key "$1")
    base=DNA_BASE_PORT_${key}
    echo $(( ${!base} + DNA_PORT_OFFSET ))
}

# ---------------------------------------------------------------- host access

HOSTX="" RT="" MODE="" COMPOSE_CMD=()

detect() {
    if [[ -n "${DNA_HOST_EXEC:-}" ]]; then
        HOSTX=${DNA_HOST_EXEC}
    elif [[ ! -e /run/.containerenv && ! -e /.dockerenv ]]; then
        HOSTX=direct
    elif command -v distrobox-host-exec >/dev/null; then
        HOSTX=distrobox
    elif command -v flatpak-spawn >/dev/null; then
        HOSTX=flatpak
    else
        die "no way to reach the host: need distrobox-host-exec (distrobox) or flatpak-spawn (Fedora toolbox, package flatpak-xdg-utils); or set DNA_HOST_EXEC=direct if you are on the host"
    fi
    if [[ -n "${DNA_RUNTIME:-}" ]]; then
        RT=${DNA_RUNTIME}
    elif host podman --version >/dev/null 2>&1; then
        RT=podman
    elif host docker --version >/dev/null 2>&1; then
        RT=docker
    else
        die "neither podman nor docker answers on the host"
    fi
    MODE=compose
    if [[ "${RT}" == "podman" ]]; then
        local ver
        ver=$(host podman version --format '{{.Client.Version}}' 2>/dev/null || echo 0)
        if [[ "$(printf '%s\n4.4.0\n' "${ver}" | sort -V | head -n1)" == "4.4.0" ]] \
            && host systemctl --user show-environment >/dev/null 2>&1; then
            MODE=quadlet
        fi
    fi
    [[ -z "${DNA_MODE:-}" ]] || MODE=${DNA_MODE}
    if [[ "${MODE}" == "compose" ]]; then
        if [[ "${RT}" == "podman" ]]; then COMPOSE_CMD=(podman compose); else COMPOSE_CMD=(docker compose); fi
        host "${COMPOSE_CMD[@]}" version >/dev/null 2>&1 \
            || die "'${COMPOSE_CMD[*]}' is not available on the host (install podman-compose or the docker compose plugin)"
    fi
}

host() {
    case "${HOSTX}" in
        direct) "$@" ;;
        distrobox) distrobox-host-exec "$@" ;;
        flatpak) flatpak-spawn --host "$@" ;;
        *) die "host access not detected" ;;
    esac
}

describe_env() {
    say "host access : ${HOSTX} (reaches the host through $(case "${HOSTX}" in direct) echo 'no wrapper, you are on the host' ;; distrobox) echo distrobox-host-exec ;; *) echo 'flatpak-spawn --host' ;; esac))"
    say "runtime     : ${RT}"
    say "mode        : ${MODE} ($([[ "${MODE}" == quadlet ]] && echo "Quadlet files in ${QUADLET_DIR}, systemd --user units" || echo "${COMPOSE_CMD[*]} with files in ${STATE}/compose"))"
    say "port offset : +${DNA_PORT_OFFSET}, all ports bind 127.0.0.1"
    say "state dir   : ${STATE}"
}

# ---------------------------------------------------------------- rendering

# sed script that fills the @VAR@ placeholders of the Quadlet templates
quadlet_sed() {
    local n key
    printf 's|@STATE@|%s|g\n' "${STATE}"
    for n in $(catalog_names); do
        shipped "${n}" || continue
        key=$(port_key "${n}")
        printf 's|@IMAGE_%s@|%s|g\n' "${n^^}" "$(image_ref "${n}")"
        printf 's|@PORT_%s@|%s|g\n' "${key}" "$(host_port "${n}")"
    done
}

quadlet_files() {
    case "$1" in
        postgres) echo "dna-postgres.container dna-postgres-data.volume" ;;
        seaweedfs) echo "dna-seaweedfs.container dna-seaweedfs-data.volume" ;;
        lakekeeper) echo "dna-lakekeeper.container dna-lakekeeper-migrate.container" ;;
        trino) echo "dna-trino.container" ;;
    esac
}

render_quadlet() { # out-dir, services...
    local out=$1 f s
    shift
    mkdir -p "${out}"
    cp "${ROOT}/quadlet/dna.network" "${out}/dna.network"
    for s in "$@"; do
        for f in $(quadlet_files "${s}"); do
            sed -f <(quadlet_sed) "${ROOT}/quadlet/${f}" > "${out}/${f}"
        done
    done
}

render_compose() { # out-dir, services...
    local out=$1 s n
    shift
    mkdir -p "${out}"
    for s in "$@"; do cp "${ROOT}/compose/${s}.yml" "${out}/${s}.yml"; done
    {
        echo "${HEADER} (non-secret variables for the compose files)"
        echo "DNA_STATE=${STATE}"
        for n in $(catalog_names); do
            shipped "${n}" || continue
            echo "DNA_IMAGE_${n^^}=$(image_ref "${n}")"
            echo "DNA_PORT_$(port_key "${n}")=$(host_port "${n}")"
        done
    } > "${out}/.env"
}

render_support() { # trino catalog (both modes)
    if [[ " $* " == *" trino "* ]]; then
        mkdir -p "${STATE}/trino/catalog"
        cp "${ROOT}/templates/trino-iceberg.properties" "${STATE}/trino/catalog/iceberg.properties"
    fi
}

# ---------------------------------------------------------------- secrets (never printed)

rand() { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
secret_exists() { host podman secret inspect "$1" >/dev/null 2>&1; }
secret_create() { printf '%s' "$2" | host podman secret create --label dna-stack=1 "$1" - >/dev/null; }

ensure_secrets() { # services...
    local pw="" sel=" $* "
    if [[ "${MODE}" == "quadlet" ]]; then
        if [[ "${sel}" == *" postgres "* ]] && ! secret_exists dna-postgres-password; then
            pw=$(rand); secret_create dna-postgres-password "${pw}"
            say "  created secret dna-postgres-password"; undo "podman secret rm dna-postgres-password"
        fi
        if [[ "${sel}" == *" lakekeeper "* ]]; then
            secret_exists dna-lakekeeper-key || { secret_create dna-lakekeeper-key "$(rand)"; say "  created secret dna-lakekeeper-key"; }
            if ! secret_exists dna-lakekeeper-pgurl; then
                [[ -n "${pw}" ]] || die "secret dna-lakekeeper-pgurl is missing and the Postgres password cannot be read back; run 'dna-stack remove --yes --secrets' and set up again"
                secret_create dna-lakekeeper-pgurl "postgresql://dna:${pw}@dna-postgres:5432/lakekeeper"
                say "  created secret dna-lakekeeper-pgurl"
            fi
        fi
    else
        umask 077
        mkdir -p "${STATE}/env"
        if [[ "${sel}" == *" postgres "* && ! -f "${STATE}/env/postgres.env" ]]; then
            printf 'POSTGRES_PASSWORD=%s\n' "$(rand)" > "${STATE}/env/postgres.env"
            say "  created ${STATE}/env/postgres.env (mode 600)"
        fi
        if [[ "${sel}" == *" lakekeeper "* && ! -f "${STATE}/env/lakekeeper.env" ]]; then
            [[ -f "${STATE}/env/postgres.env" ]] || die "lakekeeper needs ${STATE}/env/postgres.env (select postgres too)"
            pw=$(sed -n 's/^POSTGRES_PASSWORD=//p' "${STATE}/env/postgres.env")
            {
                printf 'LAKEKEEPER__PG_DATABASE_URL_READ=postgresql://dna:%s@dna-postgres:5432/lakekeeper\n' "${pw}"
                printf 'LAKEKEEPER__PG_DATABASE_URL_WRITE=postgresql://dna:%s@dna-postgres:5432/lakekeeper\n' "${pw}"
                printf 'LAKEKEEPER__PG_ENCRYPTION_KEY=%s\n' "$(rand)"
            } > "${STATE}/env/lakekeeper.env"
            say "  created ${STATE}/env/lakekeeper.env (mode 600)"
        fi
    fi
}

# ---------------------------------------------------------------- commands

compose_run() { host "${COMPOSE_CMD[@]}" -p "${NETWORK}" --project-directory "${STATE}/compose" "${@:1}"; }
compose_files() { local s; for s in "$@"; do printf -- '-f\n%s\n' "${STATE}/compose/${s}.yml"; done; }

cmd_help() {
    cat <<'TXT'
dna-stack: lakehouse and AI server containers on the host, driven from the toolbox

  doctor                       show how the host is reached, the runtime and the mode (changes nothing)
  list                         the checklist: what exists, what is selected
  setup [--only a,b] [--yes]   pick services (all off by default), print the plan, write the files
  status                       state of the selected services
  up | down [service...]       start or stop (default: everything selected)
  logs [service] [--follow]    recent logs
  lock [--root]                resolve the image digests into images.lock (state dir, or the repo copy with --root)
  remove [--yes] [--volumes] [--secrets]
                               dry run by default; removes only what this tool generated; volumes need a typed yes
  check                        static checks of the shipped files (no runtime needed)
  render --out DIR --mode quadlet|compose [--all]
                               write the files to DIR only (no host access; used by the tests)

Environment: DNA_PORT_OFFSET (default 10000), DNA_RUNTIME (podman|docker), DNA_MODE (quadlet|compose),
DNA_HOST_EXEC (direct|distrobox|flatpak), DNA_STATE, DNA_QUADLET_DIR.
TXT
}

cmd_doctor() { detect; describe_env; }

cmd_list() {
    local n mark
    for n in $(catalog_names); do
        if shipped "${n}"; then
            mark="[ ]"; is_selected "${n}" && mark="[x]"
        else mark="[-]"; fi
        printf '%s %-11s %-6s %s\n' "${mark}" "${n}" "$(tier_of "${n}")" "$(summary_of "${n}")"
    done
    say "([x] selected, [ ] available, [-] planned, not shipped yet)"
}

pick() {
    local -a avail=() chosen=()
    local n
    for n in $(catalog_names); do shipped "${n}" && avail+=("${n}"); done
    if command -v gum >/dev/null && [[ -t 0 ]]; then
        mapfile -t chosen < <(gum choose --no-limit --header "Select services (nothing is selected by default)" "${avail[@]}" || true)
    else
        for n in "${avail[@]}"; do
            read -r -p "Install ${n} ($(summary_of "${n}"))? [y/N] " ans </dev/tty || ans=n
            [[ "${ans}" =~ ^[Yy] ]] && chosen+=("${n}")
        done
    fi
    printf '%s\n' "${chosen[@]:-}"
}

cmd_setup() {
    local only="" yes=0 n
    while (( $# )); do
        case "$1" in
            --only) only=$2; shift ;;
            --yes|-y) yes=1 ;;
            *) die "unknown option $1" ;;
        esac
        shift
    done
    detect; describe_env; say
    local -a want=()
    if [[ -n "${only}" ]]; then
        IFS=',' read -r -a want <<<"${only}"
    elif [[ -t 0 ]]; then
        mapfile -t want < <(pick)
    fi
    for n in "${want[@]:-}"; do
        [[ -z "${n}" ]] && continue
        known "${n}" || die "unknown service '${n}' (see: dna-stack list)"
        shipped "${n}" || die "'${n}' is planned but not shipped yet"
    done
    local -a all
    mapfile -t all < <(closure "${want[@]:-}" | sed '/^$/d')
    [[ "${#all[@]}" -gt 0 ]] || { say "nothing selected; nothing to do (use --only a,b or run in a terminal)"; return 0; }
    say "Plan: ${all[*]}  (dependencies included)"
    for n in "${all[@]}"; do
        say "  ${n}: $(image_ref "${n}")"
    done
    if [[ "${MODE}" == "quadlet" ]]; then
        say "  write Quadlet files to ${QUADLET_DIR}, create podman secrets, systemctl --user daemon-reload"
    else
        say "  write compose files and 0600 env files under ${STATE}"
    fi
    if (( ! yes )); then
        [[ -t 0 ]] || { say "dry run: pass --yes to apply"; return 0; }
        read -r -p "Apply? [y/N] " ans
        [[ "${ans}" =~ ^[Yy] ]] || { say "nothing written"; return 0; }
    fi
    mkdir -p "${STATE}"
    printf '%s\n' "${all[@]}" > "${STATE}/selected"
    undo "dna-stack remove --yes"
    render_support "${all[@]}"
    ensure_secrets "${all[@]}"
    if [[ "${MODE}" == "quadlet" ]]; then
        mkdir -p "${QUADLET_DIR}"
        render_quadlet "${QUADLET_DIR}" "${all[@]}"
        host systemctl --user daemon-reload
    else
        render_compose "${STATE}/compose" "${all[@]}"
    fi
    say "Written. Start with: dna-stack up"
    if [[ "${MODE}" == "quadlet" ]]; then say "Note: services start at login; for boot without login run: loginctl enable-linger \$USER"; fi
}

need_selection() {
    [[ -n "$(selected)" ]] || die "nothing set up yet: run dna-stack setup"
}

cmd_up() {
    detect; need_selection
    local -a svcs; mapfile -t svcs < <(if (( $# )); then closure "$@"; else selected; fi)
    if [[ "${MODE}" == "quadlet" ]]; then
        local s
        for s in "${svcs[@]}"; do
            say "start dna-${s}.service"; host systemctl --user start "dna-${s}.service"
        done
    else
        local -a f; mapfile -t f < <(compose_files "${svcs[@]}")
        compose_run "${f[@]}" up -d
    fi
    undo "dna-stack down"
}

cmd_down() {
    detect; need_selection
    local -a svcs; mapfile -t svcs < <(if (( $# )); then printf '%s\n' "$@"; else selected; fi)
    if [[ "${MODE}" == "quadlet" ]]; then
        local i
        for (( i=${#svcs[@]}-1; i>=0; i-- )); do
            say "stop dna-${svcs[i]}.service"; host systemctl --user stop "dna-${svcs[i]}.service" || true
        done
    else
        local -a f; mapfile -t f < <(compose_files "${svcs[@]}")
        compose_run "${f[@]}" stop
    fi
    undo "dna-stack up"
}

cmd_status() {
    detect; describe_env; say
    local s
    for s in $(selected); do
        if [[ "${MODE}" == "quadlet" ]]; then
            printf '%-11s %s\n' "${s}" "$(host systemctl --user is-active "dna-${s}.service" 2>/dev/null || true)"
        else
            printf '%-11s %s\n' "${s}" "$(host "${RT}" inspect -f '{{.State.Status}}' "dna-${s}" 2>/dev/null || echo absent)"
        fi
    done
    say "ports (127.0.0.1): $(for s in $(selected); do printf '%s=%s ' "${s}" "$(host_port "${s}")"; done)"
}

cmd_logs() {
    detect; need_selection
    local svc="" follow=()
    while (( $# )); do case "$1" in --follow|-f) follow=(--follow) ;; *) svc=$1 ;; esac; shift; done
    if [[ "${MODE}" == "quadlet" ]]; then
        if [[ -n "${svc}" ]]; then host journalctl --user -u "dna-${svc}.service" -n 100 --no-pager "${follow[@]}"
        else host journalctl --user -u 'dna-*.service' -n 100 --no-pager "${follow[@]}"; fi
    else
        local -a f sel; mapfile -t sel < <(selected); mapfile -t f < <(compose_files "${sel[@]}")
        compose_run "${f[@]}" logs --tail 100 "${follow[@]}" ${svc:+"dna-${svc}"}
    fi
}

cmd_lock() {
    local target
    target=${STATE}/images.lock
    [[ "${1:-}" == "--root" ]] && target=${ROOT}/images.lock
    detect
    mkdir -p "$(dirname "${target}")"
    local tmp; tmp=$(mktemp)
    while IFS='|' read -r name ref _; do
        if [[ "${name}" == \#* || -z "${name}" ]]; then printf '%s\n' "${name}${ref:+|${ref}}" >> "${tmp}"; continue; fi
        host "${RT}" pull -q "${ref}" >/dev/null
        local digest
        digest=$(host "${RT}" image inspect --format '{{index .RepoDigests 0}}' "${ref}" | sed 's/^.*@//')
        say "${name}: ${digest}"
        printf '%s|%s|%s\n' "${name}" "${ref}" "${digest}" >> "${tmp}"
    done < "$(lockfile)"
    mv "${tmp}" "${target}"
    say "wrote ${target}"
}

is_ours() { [[ -f "$1" ]] && head -n1 "$1" | grep -q "^${HEADER}"; }

cmd_remove() {
    local yes=0 vols=0 secs=0
    while (( $# )); do
        case "$1" in --yes|-y) yes=1 ;; --volumes) vols=1 ;; --secrets) secs=1 ;; *) die "unknown option $1" ;; esac
        shift
    done
    detect
    local -a files=()
    local f
    if [[ "${MODE}" == "quadlet" ]]; then
        for f in "${QUADLET_DIR}"/dna*.container "${QUADLET_DIR}"/dna*.volume "${QUADLET_DIR}"/dna.network; do
            is_ours "${f}" && files+=("${f}")
        done
    fi
    for f in "${STATE}/compose"/*.yml "${STATE}/compose/.env" "${STATE}/trino/catalog/iceberg.properties"; do
        is_ours "${f}" && files+=("${f}")
    done
    say "Would stop the selected services and delete:"
    printf '  %s\n' "${files[@]:-}"
    (( ! secs )) || say "  and the podman secrets dna-postgres-password, dna-lakekeeper-key, dna-lakekeeper-pgurl, plus ${STATE}/env"
    (( ! vols )) || say "  and the volumes dna-postgres-data, dna-seaweedfs-data (ALL DATA)"
    if (( ! yes )); then say "dry run: pass --yes to do it"; return 0; fi
    if (( vols )); then
        read -r -p "Type yes to delete the data volumes: " ans </dev/tty || ans=no
        [[ "${ans}" == "yes" ]] || { vols=0; say "volumes kept"; }
    fi
    if [[ -n "$(selected)" ]]; then cmd_down || true; fi
    for f in "${files[@]:-}"; do [[ -n "${f}" ]] && rm -f "${f}"; done
    [[ "${MODE}" == "quadlet" ]] && host systemctl --user daemon-reload || true
    if (( secs )); then
        for f in dna-postgres-password dna-lakekeeper-key dna-lakekeeper-pgurl; do host podman secret rm "${f}" >/dev/null 2>&1 || true; done
        rm -rf "${STATE}/env"
    fi
    if (( vols )); then
        for f in dna-postgres-data dna-seaweedfs-data; do host "${RT}" volume rm "${f}" >/dev/null 2>&1 || true; done
    fi
    host "${RT}" network rm "${NETWORK}" >/dev/null 2>&1 || true
    rm -f "${STATE}/selected"
    say "removed. Set up again with: dna-stack setup"
}

cmd_render() {
    local out="" mode="" every=0
    while (( $# )); do
        case "$1" in --out) out=$2; shift ;; --mode) mode=$2; shift ;; --all) every=1 ;; *) die "unknown option $1" ;; esac
        shift
    done
    [[ -n "${out}" && -n "${mode}" ]] || die "render needs --out DIR --mode quadlet|compose"
    local -a svcs
    if (( every )); then mapfile -t svcs < <(for n in $(catalog_names); do shipped "${n}" && echo "${n}"; done)
    else mapfile -t svcs < <(selected); fi
    STATE=${DNA_STATE:-${out}/state}
    render_support "${svcs[@]}"
    case "${mode}" in
        quadlet) render_quadlet "${out}" "${svcs[@]}" ;;
        compose) render_compose "${out}" "${svcs[@]}" ;;
        *) die "mode must be quadlet or compose" ;;
    esac
}

cmd_check() { # static checks, no host access and no container runtime needed
    local tmp bad=0 f n
    tmp=$(mktemp -d)
    fail() { say "check FAIL: $*"; bad=1; }
    bash -n "${SELF}" || fail "bash -n dna-stack"
    # every shipped service has a lock line; tags are explicit (never latest); digests are sha256 or empty
    for n in $(catalog_names); do
        shipped "${n}" || continue
        [[ -n "$(image_ref "${n}")" ]] || fail "no image line for ${n}"
    done
    while IFS='|' read -r name ref digest _; do
        [[ "${name}" == \#* || -z "${name}" ]] && continue
        [[ "${ref}" =~ :[A-Za-z0-9._-]+$ && "${ref}" != *:latest ]] || fail "${name}: image '${ref}' must carry an explicit non-latest tag"
        [[ -z "${digest}" || "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "${name}: bad digest '${digest}'"
    done < "${ROOT}/images.lock"
    DNA_STATE=${tmp}/state "${SELF}" render --out "${tmp}/q" --mode quadlet --all
    DNA_STATE=${tmp}/state "${SELF}" render --out "${tmp}/c" --mode compose --all
    for f in "${tmp}"/q/* "${tmp}"/c/*.yml "${tmp}"/c/.env; do
        [[ -f "${f}" ]] || continue
        head -n1 "${f}" | grep -q "^${HEADER}" || fail "${f##*/}: missing the generated header"
        if grep -v '^Secret=' "${f}" | grep -iE '(PASSWORD|SECRET|TOKEN|KEY)[A-Z_]*[=:] *[^ $@]' >/dev/null; then
            fail "${f##*/}: looks like a secret value in a generated file"
        fi
    done
    if grep -h '^PublishPort=' "${tmp}"/q/* | grep -v '^PublishPort=127\.0\.0\.1:' >/dev/null; then fail "a Quadlet port is not bound to 127.0.0.1"; fi
    # shellcheck disable=SC2016  # the ${DNA_PORT_ text is literal
    if awk '/^ *ports:/ {on=1; next} on && /^ *- / {print; next} {on=0}' "${tmp}"/c/*.yml | grep -v '"127\.0\.0\.1:\${DNA_PORT_' >/dev/null; then
        fail "a compose port is not bound to 127.0.0.1 with an offset variable"
    fi
    while read -r p; do (( p >= DNA_PORT_OFFSET )) || fail "published port ${p} is below the offset"; done < <(sed -n 's/^DNA_PORT_[A-Z0-9_]*=//p' "${tmp}/c/.env")
    if command -v yq >/dev/null; then
        for f in "${tmp}"/c/*.yml; do yq e '.' "${f}" >/dev/null || fail "${f##*/} is not valid YAML"; done
    else say "check: yq not found, compose YAML parse skipped"; fi
    local gen=/usr/lib/systemd/system-generators/podman-system-generator
    if [[ -x "${gen}" ]]; then
        QUADLET_UNIT_DIRS=${tmp}/q "${gen}" --user --dryrun >/dev/null 2>&1 || fail "the Quadlet generator rejects the files"
    else say "check: podman Quadlet generator not found, Quadlet syntax check skipped"; fi
    rm -rf "${tmp}"
    (( bad == 0 )) || exit 1
    say "stack check ok"
}

main() {
    local c=${1:-help}
    [[ $# -eq 0 ]] || shift
    case "${c}" in
        help|-h|--help) cmd_help ;;
        doctor) cmd_doctor ;;
        list) cmd_list ;;
        setup) cmd_setup "$@" ;;
        up) cmd_up "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        lock) cmd_lock "$@" ;;
        remove) cmd_remove "$@" ;;
        render) cmd_render "$@" ;;
        check) cmd_check ;;
        *) cmd_help; exit 1 ;;
    esac
}
main "$@"
