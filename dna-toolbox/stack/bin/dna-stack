#!/usr/bin/env bash
# dna-stack: deploy the lakehouse and AI server containers on the HOST from inside the toolbox.
#
# The toolbox keeps clients and dev tools; the servers run as host containers. This script renders
# Quadlet files (podman with systemd --user) or compose files (podman compose / docker compose) and
# drives the host runtime through distrobox-host-exec (distrobox) or flatpak-spawn --host (Fedora
# toolbox). Everything is off until you pick it (`setup`); destructive steps are a dry run unless
# --yes is given. Run `dna-stack help`.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${DNA_STACK_ROOT:-/usr/share/dna-stack}
[[ -f "${ROOT}/stack.env" ]] || ROOT=$(cd "$(dirname "${SELF}")/.." && pwd)
# shellcheck source=/dev/null
source "${ROOT}/stack.env"

STATE=${DNA_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/dna-stack}
QUADLET_DIR=${DNA_QUADLET_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/containers/systemd}
HEADER='# Generated by dna-stack'
NETWORK=dna-stack

say() { printf '%s\n' "$*"; }
die() { printf 'dna-stack: %s\n' "$*" >&2; exit 1; }
undo() { printf '    undo: %s\n' "$*"; }

# ---------------------------------------------------------------- catalog

catalog_names() { awk -F'|' '!/^#/ && NF >= 4 {print $1}' "${ROOT}/catalog.tsv"; }
catalog_field() { awk -F'|' -v n="$1" -v f="$2" '$1 == n {print $f}' "${ROOT}/catalog.tsv"; }
tier_of() { catalog_field "$1" 2; }
deps_of() { catalog_field "$1" 3 | tr ',' ' '; }
summary_of() { catalog_field "$1" 4; }
shipped() { [[ "$(tier_of "$1")" == "slice" ]]; }
known() { [[ -n "$(tier_of "$1")" ]]; }

# Selected services plus their dependencies, in start order (dependencies first)
closure() {
    local -a order=()
    local n d
    add() {
        local x=$1 seen
        for seen in "${order[@]:-}"; do [[ "${seen}" == "${x}" ]] && return 0; done
        for d in $(deps_of "${x}"); do add "${d}"; done
        order+=("${x}")
    }
    for n in "$@"; do add "${n}"; done
    printf '%s\n' "${order[@]:-}"
}

selected() { [[ -f "${STATE}/selected" ]] && cat "${STATE}/selected" || true; }
is_selected() { selected | grep -qx "$1"; }

# ---------------------------------------------------------------- images and ports

lockfile() { if [[ -f "${STATE}/images.lock" ]]; then echo "${STATE}/images.lock"; else echo "${ROOT}/images.lock"; fi; }
image_ref() {
    awk -F'|' -v n="$1" '!/^#/ && $1 == n { if ($3 != "") print $2 "@" $3; else print $2 }' "$(lockfile)"
}
port_key() { case "$1" in seaweedfs) echo SEAWEEDFS_S3 ;; *) printf '%s' "${1^^}" ;; esac; }
host_port() {
    local key base
    key=$(port_key "$1")
    base=DNA_BASE_PORT_${key}
    echo $(( ${!base} + DNA_PORT_OFFSET ))
}

# ---------------------------------------------------------------- host access

HOSTX="" RT="" MODE="" COMPOSE_CMD=()

detect() {
    if [[ -n "${DNA_HOST_EXEC:-}" ]]; then
        HOSTX=${DNA_HOST_EXEC}
    elif [[ ! -e /run/.containerenv && ! -e /.dockerenv ]]; then
        HOSTX=direct
    elif command -v distrobox-host-exec >/dev/null; then
        HOSTX=distrobox
    elif command -v flatpak-spawn >/dev/null; then
        HOSTX=flatpak
    else
        die "no way to reach the host: need distrobox-host-exec (distrobox) or flatpak-spawn (Fedora toolbox, package flatpak-xdg-utils); or set DNA_HOST_EXEC=direct if you are on the host"
    fi
    if [[ -n "${DNA_RUNTIME:-}" ]]; then
        RT=${DNA_RUNTIME}
    elif host podman --version >/dev/null 2>&1; then
        RT=podman
    elif host docker --version >/dev/null 2>&1; then
        RT=docker
    else
        die "neither podman nor docker answers on the host"
    fi
    MODE=compose
    if [[ "${RT}" == "podman" ]]; then
        local ver
        ver=$(host podman version --format '{{.Client.Version}}' 2>/dev/null || echo 0)
        if [[ "$(printf '%s\n4.4.0\n' "${ver}" | sort -V | head -n1)" == "4.4.0" ]] \
            && host systemctl --user show-environment >/dev/null 2>&1; then
            MODE=quadlet
        fi
    fi
    [[ -z "${DNA_MODE:-}" ]] || MODE=${DNA_MODE}
    if [[ "${MODE}" == "compose" ]]; then
        if [[ "${RT}" == "podman" ]]; then COMPOSE_CMD=(podman compose); else COMPOSE_CMD=(docker compose); fi
        host "${COMPOSE_CMD[@]}" version >/dev/null 2>&1 \
            || die "'${COMPOSE_CMD[*]}' is not available on the host (install podman-compose or the docker compose plugin)"
    fi
}

host() {
    case "${HOSTX}" in
        direct) "$@" ;;
        distrobox) distrobox-host-exec "$@" ;;
        flatpak) flatpak-spawn --host "$@" ;;
        *) die "host access not detected" ;;
    esac
}

describe_env() {
    say "host access : ${HOSTX} (reaches the host through $(case "${HOSTX}" in direct) echo 'no wrapper, you are on the host' ;; distrobox) echo distrobox-host-exec ;; *) echo 'flatpak-spawn --host' ;; esac))"
    say "runtime     : ${RT}"
    say "mode        : ${MODE} ($([[ "${MODE}" == quadlet ]] && echo "Quadlet files in ${QUADLET_DIR}, systemd --user units" || echo "${COMPOSE_CMD[*]} with files in ${STATE}/compose"))"
    say "port offset : +${DNA_PORT_OFFSET}, all ports bind 127.0.0.1"
    say "state dir   : ${STATE}"
}

# ---------------------------------------------------------------- rendering

# sed script that fills the @VAR@ placeholders of the Quadlet templates
quadlet_sed() {
    local n key
    printf 's|@STATE@|%s|g\n' "${STATE}"
    for n in $(catalog_names); do
        shipped "${n}" || continue
        key=$(port_key "${n}")
        printf 's|@IMAGE_%s@|%s|g\n' "${n^^}" "$(image_ref "${n}")"
        printf 's|@PORT_%s@|%s|g\n' "${key}" "$(host_port "${n}")"
    done
}

quadlet_files() {
    case "$1" in
        postgres) echo "dna-postgres.container dna-postgres-data.volume" ;;
        seaweedfs) echo "dna-seaweedfs.container dna-seaweedfs-data.volume" ;;
        lakekeeper) echo "dna-lakekeeper.container dna-lakekeeper-migrate.container" ;;
        trino) echo "dna-trino.container" ;;
    esac
}

render_quadlet() { # out-dir, services...
    local out=$1 f s
    shift
    mkdir -p "${out}"
    cp "${ROOT}/quadlet/dna.network" "${out}/dna.network"
    for s in "$@"; do
        for f in $(quadlet_files "${s}"); do
            sed -f <(quadlet_sed) "${ROOT}/quadlet/${f}" > "${out}/${f}"
        done
    done
}

render_compose() { # out-dir, services...
    local out=$1 s n
    shift
    mkdir -p "${out}"
    for s in "$@"; do cp "${ROOT}/compose/${s}.yml" "${out}/${s}.yml"; done
    {
        echo "${HEADER} (non-secret variables for the compose files)"
        echo "DNA_STATE=${STATE}"
        for n in $(catalog_names); do
            shipped "${n}" || continue
            echo "DNA_IMAGE_${n^^}=$(image_ref "${n}")"
            echo "DNA_PORT_$(port_key "${n}")=$(host_port "${n}")"
        done
    } > "${out}/.env"
}

render_support() { # trino catalog (both modes); holds the S3 keys, so mode 600 (placeholders when none exist yet)
    if [[ " $* " == *" trino "* ]]; then
        local ak=EXAMPLE_KEY sk=EXAMPLE_SECRET
        if [[ -f "${STATE}/env/s3.env" ]]; then
            ak=$(sed -n 's/^S3_ACCESS_KEY=//p' "${STATE}/env/s3.env"); sk=$(sed -n 's/^S3_SECRET_KEY=//p' "${STATE}/env/s3.env")
        fi
        ( umask 077; mkdir -p "${STATE}/trino/catalog"
          sed -e "s|@WAREHOUSE@|${DNA_WAREHOUSE}|" -e "s|@REGION@|${DNA_S3_REGION}|" \
              -e "s|@S3_ACCESS_KEY@|${ak}|" -e "s|@S3_SECRET_KEY@|${sk}|" \
              "${ROOT}/templates/trino-iceberg.properties" > "${STATE}/trino/catalog/iceberg.properties" )
    fi
}

# ---------------------------------------------------------------- secrets (never printed)

rand() { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
secret_exists() { host podman secret inspect "$1" >/dev/null 2>&1; }
# The host wrapper's handling of piped stdin is unverified, so by default the value goes through a 0600
# file in the state dir (shared home, readable by the host at the same path) that is deleted at once.
# DNA_SECRET_STDIN=1 pipes it instead.
secret_create() {
    if [[ "${DNA_SECRET_STDIN:-0}" == "1" ]]; then
        printf '%s' "$2" | host podman secret create --label dna-stack=1 "$1" - >/dev/null
        return
    fi
    [[ "${STATE}" == "${HOME}"/* ]] || die "the state dir must be under the shared home so the host can read the secret file (set DNA_STATE or DNA_SECRET_STDIN=1)"
    local f
    ( umask 077; mkdir -p "${STATE}/tmp"; f=$(mktemp "${STATE}/tmp/secret.XXXXXX"); printf '%s' "$2" > "${f}"
      trap 'rm -f "${f}"' EXIT
      host podman secret create --label dna-stack=1 "$1" "${f}" >/dev/null )
}

ensure_secrets() { # services...
    local pw="" sel=" $* "
    if [[ "${sel}" == *" seaweedfs "* && ! -f "${STATE}/env/s3.env" ]]; then
        local ak sk
        ak=$(rand); sk=$(rand)
        ( umask 077; mkdir -p "${STATE}/env"
          printf 'S3_ACCESS_KEY=%s\nS3_SECRET_KEY=%s\n' "${ak}" "${sk}" > "${STATE}/env/s3.env"
          printf '{"identities":[{"name":"dna","credentials":[{"accessKey":"%s","secretKey":"%s"}],"actions":["Admin","Read","Write","List","Tagging"]}]}\n' "${ak}" "${sk}" > "${STATE}/env/seaweedfs-s3.json" )
        say "  created S3 credentials in ${STATE}/env (mode 600)"
    fi
    if [[ "${MODE}" == "quadlet" ]]; then
        if [[ "${sel}" == *" postgres "* ]] && ! secret_exists dna-postgres-password; then
            pw=$(rand); secret_create dna-postgres-password "${pw}"
            say "  created secret dna-postgres-password"; undo "podman secret rm dna-postgres-password"
        fi
        if [[ "${sel}" == *" lakekeeper "* ]]; then
            secret_exists dna-lakekeeper-key || { secret_create dna-lakekeeper-key "$(rand)"; say "  created secret dna-lakekeeper-key"; }
            if ! secret_exists dna-lakekeeper-pgurl; then
                [[ -n "${pw}" ]] || die "secret dna-lakekeeper-pgurl is missing and the Postgres password cannot be read back; run 'dna-stack remove --yes --secrets' and set up again"
                secret_create dna-lakekeeper-pgurl "postgres://dna:${pw}@dna-postgres:5432/lakekeeper"
                say "  created secret dna-lakekeeper-pgurl"
            fi
        fi
    else
        umask 077
        mkdir -p "${STATE}/env"
        if [[ "${sel}" == *" postgres "* && ! -f "${STATE}/env/postgres.env" ]]; then
            printf 'POSTGRES_PASSWORD=%s\n' "$(rand)" > "${STATE}/env/postgres.env"
            say "  created ${STATE}/env/postgres.env (mode 600)"
        fi
        if [[ "${sel}" == *" lakekeeper "* && ! -f "${STATE}/env/lakekeeper.env" ]]; then
            [[ -f "${STATE}/env/postgres.env" ]] || die "lakekeeper needs ${STATE}/env/postgres.env (select postgres too)"
            pw=$(sed -n 's/^POSTGRES_PASSWORD=//p' "${STATE}/env/postgres.env")
            {
                printf 'LAKEKEEPER__PG_DATABASE_URL_READ=postgres://dna:%s@dna-postgres:5432/lakekeeper\n' "${pw}"
                printf 'LAKEKEEPER__PG_DATABASE_URL_WRITE=postgres://dna:%s@dna-postgres:5432/lakekeeper\n' "${pw}"
                printf 'LAKEKEEPER__PG_ENCRYPTION_KEY=%s\n' "$(rand)"
            } > "${STATE}/env/lakekeeper.env"
            say "  created ${STATE}/env/lakekeeper.env (mode 600)"
        fi
    fi
}

# ---------------------------------------------------------------- commands

compose_run() { host "${COMPOSE_CMD[@]}" -p "${NETWORK}" --project-directory "${STATE}/compose" "${@:1}"; }
compose_files() { local s; for s in "$@"; do printf -- '-f\n%s\n' "${STATE}/compose/${s}.yml"; done; }

cmd_help() {
    cat <<'TXT'
dna-stack: lakehouse and AI server containers on the host, driven from the toolbox

  doctor                       show how the host is reached, the runtime and the mode (changes nothing)
  list                         the checklist: what exists, what is selected
  setup [--only a,b] [--yes]   pick services (all off by default), print the plan, write the files
  status                       state of the selected services
  up | down [service...] [--yes]
                               start or stop; with no names a checklist (all off), `up` adds missing dependencies,
                               `down` warns about services that depend on the ones you stop
  logs [service] [--follow]    recent logs
  bootstrap                    after `up`: bootstrap Lakekeeper, create the S3 bucket and the first warehouse
  lock [--root]                resolve the image digests into images.lock (state dir, or the repo copy with --root)
  remove [service...] [--yes] [--volumes] [--secrets]
                               checklist or names; dry run without --yes or a terminal; removes only what this tool
                               generated; volumes need --volumes and a typed yes
  check                        static checks of the shipped files (no runtime needed)
  render --out DIR --mode quadlet|compose [--all]
                               write the files to DIR only (no host access; used by the tests)

Environment: DNA_PORT_OFFSET (default 10000), DNA_RUNTIME (podman|docker), DNA_MODE (quadlet|compose),
DNA_HOST_EXEC (direct|distrobox|flatpak), DNA_STATE, DNA_QUADLET_DIR.
TXT
}

cmd_doctor() { detect; describe_env; }

cmd_list() {
    local n mark
    for n in $(catalog_names); do
        if shipped "${n}"; then
            mark="[ ]"; is_selected "${n}" && mark="[x]"
        else mark="[-]"; fi
        printf '%s %-11s %-6s %s\n' "${mark}" "${n}" "$(tier_of "${n}")" "$(summary_of "${n}")"
    done
    say "([x] selected, [ ] available, [-] planned, not shipped yet)"
}

pick() {
    local -a avail=() chosen=()
    local n
    for n in $(catalog_names); do shipped "${n}" && avail+=("${n}"); done
    if command -v gum >/dev/null && [[ -t 0 ]]; then
        mapfile -t chosen < <(gum choose --no-limit --header "Select services (nothing is selected by default)" "${avail[@]}" || true)
    else
        for n in "${avail[@]}"; do
            read -r -p "Install ${n} ($(summary_of "${n}"))? [y/N] " ans </dev/tty || ans=n
            [[ "${ans}" =~ ^[Yy] ]] && chosen+=("${n}")
        done
    fi
    printf '%s\n' "${chosen[@]:-}"
}

cmd_setup() {
    local only="" yes=0 n
    while (( $# )); do
        case "$1" in
            --only) only=$2; shift ;;
            --yes|-y) yes=1 ;;
            *) die "unknown option $1" ;;
        esac
        shift
    done
    detect; describe_env; say
    local -a want=()
    if [[ -n "${only}" ]]; then
        IFS=',' read -r -a want <<<"${only}"
    elif [[ -t 0 ]]; then
        mapfile -t want < <(pick)
    fi
    for n in "${want[@]:-}"; do
        [[ -z "${n}" ]] && continue
        known "${n}" || die "unknown service '${n}' (see: dna-stack list)"
        shipped "${n}" || die "'${n}' is planned but not shipped yet"
    done
    local -a all
    mapfile -t all < <(closure "${want[@]:-}" | sed '/^$/d')
    [[ "${#all[@]}" -gt 0 ]] || { say "nothing selected; nothing to do (use --only a,b or run in a terminal)"; return 0; }
    say "Plan: ${all[*]}  (dependencies included)"
    for n in "${all[@]}"; do
        say "  ${n}: $(image_ref "${n}")"
    done
    if [[ "${MODE}" == "quadlet" ]]; then
        say "  write Quadlet files to ${QUADLET_DIR}, create podman secrets, systemctl --user daemon-reload"
    else
        say "  write compose files and 0600 env files under ${STATE}"
    fi
    if (( ! yes )); then
        [[ -t 0 ]] || { say "dry run: pass --yes to apply"; return 0; }
        read -r -p "Apply? [y/N] " ans
        [[ "${ans}" =~ ^[Yy] ]] || { say "nothing written"; return 0; }
    fi
    mkdir -p "${STATE}"
    printf '%s\n' "${all[@]}" > "${STATE}/selected"
    undo "dna-stack remove --yes"
    render_support "${all[@]}"
    ensure_secrets "${all[@]}"
    if [[ "${MODE}" == "quadlet" ]]; then
        mkdir -p "${QUADLET_DIR}"
        render_quadlet "${QUADLET_DIR}" "${all[@]}"
        host systemctl --user daemon-reload
    else
        render_compose "${STATE}/compose" "${all[@]}"
    fi
    say "Written. Start with: dna-stack up"
    if [[ "${MODE}" == "quadlet" ]]; then say "Note: services start at login; for boot without login run: loginctl enable-linger \$USER"; fi
}

need_selection() {
    [[ -n "$(selected)" ]] || die "nothing set up yet: run dna-stack setup"
}

# The dependency map from the catalog, as text for the warnings
dep_map() {
    local n
    for n in $(catalog_names); do
        shipped "${n}" || continue
        [[ -n "$(deps_of "${n}")" ]] && printf '    %s needs %s\n' "${n}" "$(deps_of "${n}" | sed 's/ /, /g')"
    done
}
dep_warning() {
    say "WARNING: some services depend on others:"
    dep_map
    say "  up adds missing dependencies for you; down and remove never cascade silently."
}

# Services of $2... that need $1 (directly or through others)
dependents_in() {
    local x=$1 s
    shift
    for s in "$@"; do
        [[ "${s}" == "${x}" ]] && continue
        closure "${s}" | grep -qx "${x}" && echo "${s}"
    done
}

is_running() {
    if [[ "${MODE}" == "quadlet" ]]; then host systemctl --user is-active --quiet "dna-$1.service" 2>/dev/null
    else [[ "$(host "${RT}" inspect -f '{{.State.Running}}' "dna-$1" 2>/dev/null || true)" == "true" ]]; fi
}

# Checklist of $1 (header) over the remaining names, all OFF; prints the chosen names. Same picker as setup:
# gum when present, else one y/N question each; without a terminal nothing is chosen.
pick_from() {
    local header=$1 n ans
    shift
    [[ -t 0 ]] || return 0
    if command -v gum >/dev/null; then
        gum choose --no-limit --header "${header}" "$@" || true
    else
        for n in "$@"; do
            read -r -p "${n} ($(summary_of "${n}"))? [y/N] " ans </dev/tty || ans=n
            [[ "${ans}" =~ ^[Yy] ]] && echo "${n}"
        done
    fi
    return 0
}

# Shared front half of up, down and remove. Sets CHOSEN (array) and YES. Candidates are given by the caller.
parse_names() { # args: the command line after the verb; fills NAMES and YES and EXTRA (other options)
    NAMES=() YES=0 EXTRA=()
    local a
    for a in "$@"; do
        case "${a}" in
            --yes|-y) YES=1 ;;
            --volumes|--secrets) EXTRA+=("${a}") ;;
            -*) die "unknown option ${a}" ;;
            *) known "${a}" || die "unknown service '${a}' (see: dna-stack list)"; NAMES+=("${a}") ;;
        esac
    done
}

# down and remove: a selected service that a non-selected one depends on must be named and confirmed.
# Prints the second warning; returns 0 to go on, 1 to stop (dry run or declined). May extend CHOSEN.
confirm_dependents() { # verb, candidates (the running or generated services)...
    local verb=$1 d x
    shift
    local -a cand=("$@") deps=()
    for x in "${CHOSEN[@]}"; do
        for d in $(dependents_in "${x}" "${cand[@]}"); do
            printf '%s\n' "${CHOSEN[@]}" | grep -qx "${d}" || { printf '%s\n' "${deps[@]:-}" | grep -qx "${d}" || deps+=("${d}"); }
        done
    done
    [[ "${#deps[@]}" -gt 0 ]] || return 0
    say "WARNING: ${deps[*]} depend(s) on ${CHOSEN[*]} and would stay in place without it (not selected)."
    if [[ -t 0 ]]; then
        local ans
        read -r -p "Add ${deps[*]} to the ${verb} list as well? [y/N] " ans
        if [[ "${ans}" =~ ^[Yy] ]]; then CHOSEN+=("${deps[@]}"); return 0; fi
        read -r -p "${verb} ${CHOSEN[*]} anyway, leaving ${deps[*]} as they are? [y/N] " ans
        [[ "${ans}" =~ ^[Yy] ]] && return 0
        say "nothing done"; return 1
    fi
    (( YES )) && return 0
    say "dry run: pass --yes to ${verb} ${CHOSEN[*]} anyway, or name the dependents too"
    return 1
}

cmd_up() {
    parse_names "$@"
    detect; need_selection
    local -a conf=() idle=() want=()
    local s
    mapfile -t conf < <(selected)
    for s in "${conf[@]}"; do is_running "${s}" || idle+=("${s}"); done
    if [[ "${#NAMES[@]}" -gt 0 ]]; then
        want=("${NAMES[@]}")
    elif (( YES )); then
        want=("${idle[@]:-}")
    else
        [[ "${#idle[@]}" -gt 0 ]] || { say "everything configured is already running"; return 0; }
        dep_warning
        mapfile -t want < <(pick_from "Start which services? (nothing is selected by default)" "${idle[@]}")
        if [[ "${#want[@]}" -eq 0 ]]; then say "nothing chosen (dry run: name services, or pass --yes to start everything configured)"; return 0; fi
    fi
    local -a svcs=()
    mapfile -t svcs < <(closure "${want[@]}" | sed '/^$/d')
    local extra=()
    for s in "${svcs[@]}"; do printf '%s\n' "${want[@]}" | grep -qx "${s}" || extra+=("${s}"); done
    [[ "${#extra[@]}" -eq 0 ]] || say "also starting the dependencies: ${extra[*]}"
    for s in "${svcs[@]}"; do printf '%s\n' "${conf[@]}" | grep -qx "${s}" || die "${s} is not set up (dna-stack setup --only ${s})"; done
    if [[ "${MODE}" == "quadlet" ]]; then
        for s in "${svcs[@]}"; do
            say "start dna-${s}.service"; host systemctl --user start "dna-${s}.service"
        done
    else
        local -a f; mapfile -t f < <(compose_files "${svcs[@]}")
        compose_run "${f[@]}" up -d
    fi
    undo "dna-stack down ${svcs[*]}"
}

cmd_down() {
    parse_names "$@"
    detect; need_selection
    local -a run=() CHOSEN=()
    local s
    for s in $(selected); do is_running "${s}" && run+=("${s}"); done
    [[ "${#run[@]}" -gt 0 ]] || { say "nothing is running"; return 0; }
    if [[ "${#NAMES[@]}" -gt 0 ]]; then CHOSEN=("${NAMES[@]}")
    elif (( YES )); then CHOSEN=("${run[@]}")
    else
        dep_warning
        mapfile -t CHOSEN < <(pick_from "Stop which services? (nothing is selected by default)" "${run[@]}")
        [[ "${#CHOSEN[@]}" -gt 0 ]] || { say "nothing chosen (dry run: name services, or pass --yes to stop everything running)"; return 0; }
    fi
    if [[ "${#NAMES[@]}" -gt 0 || "${#CHOSEN[@]}" -lt "${#run[@]}" ]]; then
        confirm_dependents stop "${run[@]}" || return 0
    fi
    stop_services "${CHOSEN[@]}"
    undo "dna-stack up ${CHOSEN[*]}"
}

# Stop in reverse start order
stop_services() {
    local -a order=()
    mapfile -t order < <(closure "$@" | sed '/^$/d')
    local -a only=() ; local s i
    for s in "${order[@]}"; do printf '%s\n' "$@" | grep -qx "${s}" && only+=("${s}"); done
    if [[ "${MODE}" == "quadlet" ]]; then
        for (( i=${#only[@]}-1; i>=0; i-- )); do
            say "stop dna-${only[i]}.service"; host systemctl --user stop "dna-${only[i]}.service" || true
        done
    else
        local -a f; mapfile -t f < <(compose_files "${only[@]}")
        compose_run "${f[@]}" stop "${only[@]/#/dna-}"
    fi
}

cmd_status() {
    detect; describe_env; say
    local s
    for s in $(selected); do
        if [[ "${MODE}" == "quadlet" ]]; then
            printf '%-11s %s\n' "${s}" "$(host systemctl --user is-active "dna-${s}.service" 2>/dev/null || true)"
        else
            printf '%-11s %s\n' "${s}" "$(host "${RT}" inspect -f '{{.State.Status}}' "dna-${s}" 2>/dev/null || echo absent)"
        fi
    done
    say "ports (127.0.0.1): $(for s in $(selected); do printf '%s=%s ' "${s}" "$(host_port "${s}")"; done)"
}

cmd_logs() {
    detect; need_selection
    local svc="" follow=()
    while (( $# )); do case "$1" in --follow|-f) follow=(--follow) ;; *) svc=$1 ;; esac; shift; done
    if [[ "${MODE}" == "quadlet" ]]; then
        if [[ -n "${svc}" ]]; then host journalctl --user -u "dna-${svc}.service" -n 100 --no-pager "${follow[@]}"
        else host journalctl --user -u 'dna-*.service' -n 100 --no-pager "${follow[@]}"; fi
    else
        local -a f sel; mapfile -t sel < <(selected); mapfile -t f < <(compose_files "${sel[@]}")
        compose_run "${f[@]}" logs --tail 100 "${follow[@]}" ${svc:+"dna-${svc}"}
    fi
}

# One-time setup of a running stack: Lakekeeper bootstrap, the S3 bucket and the first warehouse.
# Talks to the published localhost ports (distrobox and Fedora toolbox share the host network).
# UNVERIFIED against a live Lakekeeper: the credential field names differ between its docs and its
# repo example, so both spellings are tried.
cmd_bootstrap() {
    local lk s3 i
    lk=$(host_port lakekeeper); s3=$(host_port seaweedfs)
    [[ -f "${STATE}/env/s3.env" ]] || die "no S3 credentials: set up seaweedfs and lakekeeper first"
    local ak sk
    ak=$(sed -n 's/^S3_ACCESS_KEY=//p' "${STATE}/env/s3.env"); sk=$(sed -n 's/^S3_SECRET_KEY=//p' "${STATE}/env/s3.env")
    for i in $(seq 1 30); do
        curl -fsS "http://127.0.0.1:${lk}/health" >/dev/null 2>&1 && break
        [[ "${i}" -lt 30 ]] || die "Lakekeeper does not answer on 127.0.0.1:${lk} (dna-stack up first)"
        sleep 2
    done
    say "bootstrap Lakekeeper"
    curl -fsS -X POST "http://127.0.0.1:${lk}/management/v1/bootstrap" -H 'Content-Type: application/json' \
        -d '{"accept-terms-of-use": true}' >/dev/null || say "  (already bootstrapped, or refused: continuing)"
    say "create bucket ${DNA_BUCKET}"
    curl -fsS -X PUT --aws-sigv4 "aws:amz:${DNA_S3_REGION}:s3" --user "${ak}:${sk}" \
        "http://127.0.0.1:${s3}/${DNA_BUCKET}" >/dev/null || say "  (bucket exists, or the request failed: continuing)"
    say "create warehouse ${DNA_WAREHOUSE}"
    local names ok=0
    for names in "access-key-id secret-access-key" "aws-access-key-id aws-secret-access-key"; do
        read -r kn sn <<<"${names}"
        if printf '{"warehouse-name":"%s","project-id":"00000000-0000-0000-0000-000000000000","storage-profile":{"type":"s3","bucket":"%s","key-prefix":"warehouse","endpoint":"http://dna-seaweedfs:8333","region":"%s","path-style-access":true,"flavor":"s3-compat","sts-enabled":false},"storage-credential":{"type":"s3","credential-type":"access-key","%s":"%s","%s":"%s"}}' \
            "${DNA_WAREHOUSE}" "${DNA_BUCKET}" "${DNA_S3_REGION}" "${kn}" "${ak}" "${sn}" "${sk}" \
            | curl -fsS -X POST "http://127.0.0.1:${lk}/management/v1/warehouse" -H 'Content-Type: application/json' --data-binary @- >/dev/null; then
            ok=1; break
        fi
    done
    if (( ok )); then say "warehouse created"; else say "warehouse not created (it may exist already); check Lakekeeper's logs"; fi
    undo "dna-stack remove --yes --volumes"
}

cmd_lock() {
    local target
    target=${STATE}/images.lock
    [[ "${1:-}" == "--root" ]] && target=${ROOT}/images.lock
    detect
    mkdir -p "$(dirname "${target}")"
    local tmp; tmp=$(mktemp)
    while IFS='|' read -r name ref _; do
        if [[ "${name}" == \#* || -z "${name}" ]]; then printf '%s\n' "${name}${ref:+|${ref}}" >> "${tmp}"; continue; fi
        host "${RT}" pull -q "${ref}" >/dev/null
        local digest
        digest=$(host "${RT}" image inspect --format '{{index .RepoDigests 0}}' "${ref}" | sed 's/^.*@//')
        say "${name}: ${digest}"
        printf '%s|%s|%s\n' "${name}" "${ref}" "${digest}" >> "${tmp}"
    done < "$(lockfile)"
    mv "${tmp}" "${target}"
    say "wrote ${target}"
}

is_ours() { [[ -f "$1" ]] && head -n1 "$1" | grep -q "^${HEADER}"; }

svc_files() { # generated files of one service
    local s=$1 f
    if [[ "${MODE}" == "quadlet" ]]; then
        for f in $(quadlet_files "${s}"); do echo "${QUADLET_DIR}/${f}"; done
    else
        echo "${STATE}/compose/${s}.yml"
        [[ "${s}" == "trino" ]] && echo "${STATE}/trino/catalog/iceberg.properties"
    fi
}
svc_volumes() { case "$1" in postgres) echo dna-postgres-data ;; seaweedfs) echo dna-seaweedfs-data ;; esac; }
svc_secrets() { case "$1" in postgres) echo dna-postgres-password ;; lakekeeper) echo "dna-lakekeeper-key dna-lakekeeper-pgurl" ;; esac; }

cmd_remove() {
    parse_names "$@"
    detect
    local vols=0 secs=0 e
    for e in "${EXTRA[@]:-}"; do [[ "${e}" == "--volumes" ]] && vols=1; [[ "${e}" == "--secrets" ]] && secs=1; done
    local -a made=() CHOSEN=()
    local s
    for s in $(selected); do made+=("${s}"); done
    [[ "${#made[@]}" -gt 0 ]] || { say "nothing generated; nothing to remove"; return 0; }
    if [[ "${#NAMES[@]}" -gt 0 ]]; then CHOSEN=("${NAMES[@]}")
    elif (( YES )); then CHOSEN=("${made[@]}")
    elif [[ -t 0 ]]; then
        dep_warning
        mapfile -t CHOSEN < <(pick_from "Remove which services? (nothing is selected by default)" "${made[@]}")
        [[ "${#CHOSEN[@]}" -gt 0 ]] || { say "nothing chosen"; return 0; }
    else
        dep_warning
        say "Generated: ${made[*]}"
        say "dry run: name services, or pass --yes to remove everything generated"
        return 0
    fi
    for s in "${CHOSEN[@]}"; do printf '%s\n' "${made[@]}" | grep -qx "${s}" || die "${s} is not set up"; done
    if [[ "${#NAMES[@]}" -gt 0 || "${#CHOSEN[@]}" -lt "${#made[@]}" ]]; then
        confirm_dependents remove "${made[@]}" || return 0
    fi
    say "Would stop and delete (generated files only):"
    local -a files=()
    local f
    for s in "${CHOSEN[@]}"; do for f in $(svc_files "${s}"); do is_ours "${f}" && files+=("${f}"); done; done
    printf '  %s\n' "${files[@]:-}"
    (( ! secs )) || say "  and the secrets of: ${CHOSEN[*]}"
    (( ! vols )) || say "  and the data volumes of: ${CHOSEN[*]} (ALL DATA)"
    if (( ! YES )) && [[ ! -t 0 ]]; then say "dry run: pass --yes to do it"; return 0; fi
    if (( ! YES )); then
        local ans
        read -r -p "Remove these? [y/N] " ans
        [[ "${ans}" =~ ^[Yy] ]] || { say "nothing done"; return 0; }
    fi
    if (( vols )); then
        local ans=no
        if [[ -t 0 ]]; then read -r -p "Type yes to delete the data volumes: " ans || ans=no; fi
        [[ "${ans}" == "yes" ]] || { vols=0; say "volumes kept (they need a typed yes in a terminal)"; }
    fi
    local -a live=()
    for s in "${CHOSEN[@]}"; do is_running "${s}" && live+=("${s}"); done
    [[ "${#live[@]}" -eq 0 ]] || stop_services "${live[@]}"
    for f in "${files[@]:-}"; do [[ -n "${f}" ]] && rm -f "${f}"; done
    for s in "${CHOSEN[@]}"; do
        if (( secs )); then
            for f in $(svc_secrets "${s}"); do host podman secret rm "${f}" >/dev/null 2>&1 || true; done
        fi
        if (( vols )); then
            for f in $(svc_volumes "${s}"); do host "${RT}" volume rm "${f}" >/dev/null 2>&1 || true; done
        fi
    done
    local -a left=()
    for s in "${made[@]}"; do printf '%s\n' "${CHOSEN[@]}" | grep -qx "${s}" || left+=("${s}"); done
    if [[ "${#left[@]}" -gt 0 ]]; then printf '%s\n' "${left[@]}" > "${STATE}/selected"
    else
        rm -f "${STATE}/selected" "${STATE}/compose/.env" "${QUADLET_DIR}/dna.network"
        host "${RT}" network rm "${NETWORK}" >/dev/null 2>&1 || true
        (( ! secs )) || rm -rf "${STATE}/env"
    fi
    [[ "${MODE}" != "quadlet" ]] || host systemctl --user daemon-reload
    say "removed: ${CHOSEN[*]}. Set up again with: dna-stack setup"
}

cmd_render() {
    local out="" mode="" every=0
    while (( $# )); do
        case "$1" in --out) out=$2; shift ;; --mode) mode=$2; shift ;; --all) every=1 ;; *) die "unknown option $1" ;; esac
        shift
    done
    [[ -n "${out}" && -n "${mode}" ]] || die "render needs --out DIR --mode quadlet|compose"
    local -a svcs
    if (( every )); then mapfile -t svcs < <(for n in $(catalog_names); do shipped "${n}" && echo "${n}"; done)
    else mapfile -t svcs < <(selected); fi
    STATE=${DNA_STATE:-${out}/state}
    render_support "${svcs[@]}"
    case "${mode}" in
        quadlet) render_quadlet "${out}" "${svcs[@]}" ;;
        compose) render_compose "${out}" "${svcs[@]}" ;;
        *) die "mode must be quadlet or compose" ;;
    esac
}

cmd_check() { # static checks, no host access and no container runtime needed
    local tmp bad=0 f n
    tmp=$(mktemp -d)
    fail() { say "check FAIL: $*"; bad=1; }
    bash -n "${SELF}" || fail "bash -n dna-stack"
    # every shipped service has a lock line; tags are explicit (never latest); digests are sha256 or empty
    for n in $(catalog_names); do
        shipped "${n}" || continue
        [[ -n "$(image_ref "${n}")" ]] || fail "no image line for ${n}"
    done
    while IFS='|' read -r name ref digest _; do
        [[ "${name}" == \#* || -z "${name}" ]] && continue
        [[ "${ref}" =~ :[A-Za-z0-9._-]+$ && "${ref}" != *:latest ]] || fail "${name}: image '${ref}' must carry an explicit non-latest tag"
        [[ -z "${digest}" || "${digest}" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "${name}: bad digest '${digest}'"
    done < "${ROOT}/images.lock"
    DNA_STATE=${tmp}/state "${SELF}" render --out "${tmp}/q" --mode quadlet --all
    DNA_STATE=${tmp}/state "${SELF}" render --out "${tmp}/c" --mode compose --all
    for f in "${tmp}"/q/* "${tmp}"/c/*.yml "${tmp}"/c/.env; do
        [[ -f "${f}" ]] || continue
        head -n1 "${f}" | grep -q "^${HEADER}" || fail "${f##*/}: missing the generated header"
        if grep -v -e '^Secret=' -e 'SECRET_BACKEND' "${f}" | grep -iE '(PASSWORD|SECRET|TOKEN|KEY)[A-Z_]*[=:] *[^ $@]' >/dev/null; then
            fail "${f##*/}: looks like a secret value in a generated file"
        fi
    done
    if grep -h '^PublishPort=' "${tmp}"/q/* | grep -v '^PublishPort=127\.0\.0\.1:' >/dev/null; then fail "a Quadlet port is not bound to 127.0.0.1"; fi
    # shellcheck disable=SC2016  # the ${DNA_PORT_ text is literal
    if awk '/^ *ports:/ {on=1; next} on && /^ *- / {print; next} {on=0}' "${tmp}"/c/*.yml | grep -v '"127\.0\.0\.1:\${DNA_PORT_' >/dev/null; then
        fail "a compose port is not bound to 127.0.0.1 with an offset variable"
    fi
    while read -r p; do (( p >= DNA_PORT_OFFSET )) || fail "published port ${p} is below the offset"; done < <(sed -n 's/^DNA_PORT_[A-Z0-9_]*=//p' "${tmp}/c/.env")
    if command -v yq >/dev/null; then
        for f in "${tmp}"/c/*.yml; do yq e '.' "${f}" >/dev/null || fail "${f##*/} is not valid YAML"; done
    else say "check: yq not found, compose YAML parse skipped"; fi
    local gen=/usr/lib/systemd/system-generators/podman-system-generator
    if [[ -x "${gen}" ]]; then
        QUADLET_UNIT_DIRS=${tmp}/q "${gen}" --user --dryrun >/dev/null 2>&1 || fail "the Quadlet generator rejects the files"
    else say "check: podman Quadlet generator not found, Quadlet syntax check skipped"; fi
    rm -rf "${tmp}"
    (( bad == 0 )) || exit 1
    say "stack check ok"
}

main() {
    local c=${1:-help}
    [[ $# -eq 0 ]] || shift
    case "${c}" in
        help|-h|--help) cmd_help ;;
        doctor) cmd_doctor ;;
        list) cmd_list ;;
        setup) cmd_setup "$@" ;;
        up) cmd_up "$@" ;;
        down) cmd_down "$@" ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        lock) cmd_lock "$@" ;;
        bootstrap) cmd_bootstrap ;;
        remove) cmd_remove "$@" ;;
        render) cmd_render "$@" ;;
        check) cmd_check ;;
        *) cmd_help; exit 1 ;;
    esac
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
