# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED: written from memory of the Airflow 3.x docs, not run (see compose/airflow.yml).
[Unit]
Description=dna-stack Airflow DAG processor
Requires=dna-airflow-migrate.service
After=dna-airflow-migrate.service
[Container]
Image=@IMAGE_AIRFLOW@
ContainerName=dna-airflow-dag-processor
Label=dna-stack=1
Network=dna.network
Exec=dag-processor
Environment=AIRFLOW__CORE__EXECUTOR=LocalExecutor
Environment=AIRFLOW__CORE__LOAD_EXAMPLES=false
Environment=AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://dna-airflow-apiserver:8080/execution/
Environment=LAKEHOUSE_HOME=/opt/lakehouse
Secret=dna-airflow-sqlconn,type=env,target=AIRFLOW__DATABASE__SQL_ALCHEMY_CONN
Secret=dna-airflow-fernet,type=env,target=AIRFLOW__CORE__FERNET_KEY
Secret=dna-airflow-jwt,type=env,target=AIRFLOW__API_AUTH__JWT_SECRET
Volume=@STATE@/airflow/dags:/opt/airflow/dags:z
Volume=@STATE@/airflow/lakehouse:/opt/lakehouse:z
Volume=dna-airflow-logs.volume:/opt/airflow/logs
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
