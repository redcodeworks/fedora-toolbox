# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
[Unit]
Description=dna-stack Postgres
[Container]
Image=@IMAGE_POSTGRES@
ContainerName=dna-postgres
Label=dna-stack=1
Network=dna.network
Volume=dna-postgres-data.volume:/var/lib/postgresql/data
PublishPort=127.0.0.1:@PORT_POSTGRES@:5432
Environment=POSTGRES_USER=dna
Environment=POSTGRES_DB=lakekeeper
Secret=dna-postgres-password,type=env,target=POSTGRES_PASSWORD
HealthCmd=pg_isready -U dna -d lakekeeper
HealthInterval=5s
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
