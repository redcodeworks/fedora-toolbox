# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED: the Debezium image variable names are from memory, not run.
[Unit]
Description=dna-stack Kafka Connect
Requires=dna-kafka.service
After=dna-kafka.service
[Container]
Image=@IMAGE_CONNECT@
ContainerName=dna-connect
Label=dna-stack=1
Network=dna.network
PublishPort=127.0.0.1:@PORT_CONNECT@:8083
Environment=BOOTSTRAP_SERVERS=dna-kafka:9092
Environment=GROUP_ID=dna-connect
Environment=CONFIG_STORAGE_TOPIC=dna_connect_configs
Environment=OFFSET_STORAGE_TOPIC=dna_connect_offsets
Environment=STATUS_STORAGE_TOPIC=dna_connect_status
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
