# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED: not run (see compose/superset.yml).
[Unit]
Description=dna-stack Superset database upgrade
Requires=dna-postgres.service
After=dna-postgres.service
[Container]
Image=@IMAGE_SUPERSET@
ContainerName=dna-superset-init
Label=dna-stack=1
Network=dna.network
Exec=sh -c "superset db upgrade && superset init"
Secret=dna-superset-secret-key,type=env,target=SUPERSET_SECRET_KEY
Secret=dna-superset-dburi,type=env,target=SUPERSET_DB_URI
Volume=@STATE@/superset/superset_config.py:/app/pythonpath/superset_config.py:ro,z
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
