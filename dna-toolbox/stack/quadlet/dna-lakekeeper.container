# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# See compose/lakekeeper.yml: the command is the argument of the image entrypoint.
[Unit]
Description=dna-stack Lakekeeper
Requires=dna-lakekeeper-migrate.service
After=dna-lakekeeper-migrate.service
[Container]
Image=@IMAGE_LAKEKEEPER@
ContainerName=dna-lakekeeper
Label=dna-stack=1
Network=dna.network
PublishPort=127.0.0.1:@PORT_LAKEKEEPER@:8181
Exec=serve
Environment=LAKEKEEPER__SECRET_BACKEND=postgres
HealthCmd=/home/nonroot/lakekeeper healthcheck
HealthInterval=10s
Secret=dna-lakekeeper-pgurl,type=env,target=LAKEKEEPER__PG_DATABASE_URL_READ
Secret=dna-lakekeeper-pgurl,type=env,target=LAKEKEEPER__PG_DATABASE_URL_WRITE
Secret=dna-lakekeeper-key,type=env,target=LAKEKEEPER__PG_ENCRYPTION_KEY
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
