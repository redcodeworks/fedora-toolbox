# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# `mini` follows the Lakekeeper v0.13.1 example (see compose/seaweedfs.yml). UNVERIFIED: not run, and
# whether the image has wget for the healthcheck. The identity file is generated by setup (mode 600).
[Unit]
Description=dna-stack SeaweedFS
[Container]
Image=@IMAGE_SEAWEEDFS@
ContainerName=dna-seaweedfs
Label=dna-stack=1
Network=dna.network
Volume=dna-seaweedfs-data.volume:/data
PublishPort=127.0.0.1:@PORT_SEAWEEDFS_S3@:8333
Volume=@STATE@/env/seaweedfs-s3.json:/etc/seaweedfs/s3.json:ro,z
Exec=mini -dir=/data -bucket=dna-warehouse -s3.config=/etc/seaweedfs/s3.json
HealthCmd=wget -q -O /dev/null http://localhost:8333/status
HealthInterval=10s
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
