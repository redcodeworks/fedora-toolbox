# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED draft: S3 without identities, safe only because the port binds 127.0.0.1.
[Unit]
Description=dna-stack SeaweedFS
[Container]
Image=@IMAGE_SEAWEEDFS@
ContainerName=dna-seaweedfs
Label=dna-stack=1
Network=dna.network
Volume=dna-seaweedfs-data.volume:/data
PublishPort=127.0.0.1:@PORT_SEAWEEDFS_S3@:8333
Exec=server -dir=/data -s3 -ip.bind=0.0.0.0
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
