# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED draft (see compose/lakekeeper.yml).
[Unit]
Description=dna-stack Lakekeeper database migration
Requires=dna-postgres.service
After=dna-postgres.service
[Container]
Image=@IMAGE_LAKEKEEPER@
ContainerName=dna-lakekeeper-migrate
Label=dna-stack=1
Network=dna.network
Exec=migrate
Secret=dna-lakekeeper-pgurl,type=env,target=LAKEKEEPER__PG_DATABASE_URL_READ
Secret=dna-lakekeeper-pgurl,type=env,target=LAKEKEEPER__PG_DATABASE_URL_WRITE
Secret=dna-lakekeeper-key,type=env,target=LAKEKEEPER__PG_ENCRYPTION_KEY
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
