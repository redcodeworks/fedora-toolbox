# Generated by dna-stack (dna-toolbox). Do not edit; `dna-stack remove` deletes files with this header.
# UNVERIFIED: the KAFKA_* variable names are from the image docs from memory, not run.
[Unit]
Description=dna-stack Kafka (KRaft, single node)
[Container]
Image=@IMAGE_KAFKA@
ContainerName=dna-kafka
Label=dna-stack=1
Network=dna.network
Volume=dna-kafka-data.volume:/var/lib/kafka/data
PublishPort=127.0.0.1:@PORT_KAFKA@:9094
Environment=KAFKA_NODE_ID=1
Environment=KAFKA_PROCESS_ROLES=broker,controller
Environment=KAFKA_LISTENERS=INTERNAL://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093,EXTERNAL://0.0.0.0:9094
Environment=KAFKA_ADVERTISED_LISTENERS=INTERNAL://dna-kafka:9092,EXTERNAL://localhost:@PORT_KAFKA@
Environment=KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=INTERNAL:PLAINTEXT,CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT
Environment=KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
Environment=KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
Environment=KAFKA_CONTROLLER_QUORUM_VOTERS=1@dna-kafka:9093
Environment=KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
[Service]
Restart=on-failure
[Install]
WantedBy=default.target
