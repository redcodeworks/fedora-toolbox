# Shared settings of the dna stack (read by bin/dna-stack, written into the generated .env for compose).
# Everything here can be overridden from the environment.

# Added to every published host port, so the stack runs next to another one (Kevin's own lakehouse on
# nox uses the usual ports). All ports bind 127.0.0.1 only.
DNA_PORT_OFFSET=${DNA_PORT_OFFSET:-10000}

# Usual in-container ports (the published host port is the usual port + DNA_PORT_OFFSET)
DNA_BASE_PORT_POSTGRES=5432
DNA_BASE_PORT_SEAWEEDFS_S3=8333
DNA_BASE_PORT_LAKEKEEPER=8181
DNA_BASE_PORT_TRINO=8080

# Names used by `dna-stack bootstrap` and the Trino catalog
DNA_S3_REGION=local-01
DNA_BUCKET=dna-warehouse
DNA_WAREHOUSE=dna
