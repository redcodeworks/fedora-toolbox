# Binary image, not a toolbox: FROM scratch, libextest.so built from the pinned upstream commit (see README.md).
IMAGE_NAME=extest-bin
IMAGE_DESC="libextest.so (extest), 64-bit and 32-bit, built from a pinned upstream commit"
IMAGE_KIND=binary
BUILD_CONTEXT=.
EXTRA_PATHS=binary-build
BINARY_FILES="lib64/libextest.so lib/libextest.so"
IMAGE_SCHEDULE=false
