#!/usr/bin/env bash
# Format the staged Python files with ruff and the staged shell files with shfmt, then stage the result.
# Opt-in: enabled with `just install-hooks`; a missing tool skips its step and never blocks the commit.
set -euo pipefail

# Keep in step with the version used when the files were formatted
RUFF_VERSION=0.17.5

cd "$(git rev-parse --show-toplevel)"

# Staged, added or modified files; shell files are found by shfmt (extension or shebang)
mapfile -d '' staged < <(git diff --cached --name-only --diff-filter=ACM -z)
[[ ${#staged[@]} -eq 0 ]] && exit 0

py=()
for f in "${staged[@]}"; do
    [[ "$f" == *.py ]] && py+=("$f")
done
sh=()
if command -v shfmt >/dev/null 2>&1; then
    mapfile -t sh < <(shfmt -f -- "${staged[@]}")
else
    echo "pre-commit: shfmt is not installed, so the shell files were not formatted" >&2
fi

if [[ ${#py[@]} -gt 0 ]]; then
    if command -v uv >/dev/null 2>&1; then
        uvx --quiet "ruff@${RUFF_VERSION}" format -- "${py[@]}" || echo "pre-commit: ruff could not run, so the Python files were not formatted" >&2
        git add -- "${py[@]}"
    else
        echo "pre-commit: uv is not installed, so the Python files were not formatted" >&2
    fi
fi

if [[ ${#sh[@]} -gt 0 ]]; then
    shfmt -w -- "${sh[@]}"
    git add -- "${sh[@]}"
fi
