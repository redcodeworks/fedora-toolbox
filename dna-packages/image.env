# Data image, not a toolbox: FROM scratch, the dna-toolbox package lists and the shared installer (see README.md).
IMAGE_NAME=dna-packages
IMAGE_DESC="Package manifest of dna-toolbox (core and optional lists) and its installer"
IMAGE_KIND=list
BUILD_CONTEXT=.
EXTRA_PATHS=package-installer
DATA_FILES="dna-packages/core.txt:core.txt dna-packages/optional.txt:optional.txt package-installer/install.sh:install.sh dna-packages/README.md:README"
# A rebuild only changes the created label, so the weekly schedule leaves it alone (consumers pin the digest)
IMAGE_SCHEDULE=false
