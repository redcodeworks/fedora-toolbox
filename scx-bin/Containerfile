# Published as ghcr.io/redcodeworks/scx-bin: scx_rusty and scx_lavd (sched_ext CPU schedulers) built from the release
# pinned in upstream.env, nothing else. The builder is a Fedora 45 container (the release of the octarine-os image that
# copies the binaries in) pinned by digest, with the toolchain from Fedora's own repositories. The build fails unless the
# checked-out tag is the pinned commit, and cargo runs with --locked. Build context: the repository root.
FROM registry.fedoraproject.org/fedora:45@sha256:e15959f36d52307f176f8c068009f6f1451c3b238b37a1f03e56dbfa4526e8b1 AS build

RUN dnf5 -y install --setopt=install_weak_deps=False --setopt=strict=1 \
        git-core rust cargo clang llvm lld libbpf-devel elfutils-libelf-devel zlib-devel libzstd-devel \
        pkgconf-pkg-config bpftool make gcc binutils \
    && dnf5 clean all

COPY binary-build /binary-build
COPY scx-bin/upstream.env /upstream.env

RUN /binary-build/fetch-source.sh /upstream.env /src

WORKDIR /src
# Both schedulers from the one tag, one invocation. The BPF side is compiled by scx's build scripts with clang.
RUN cargo build --release --locked -p scx_rusty -p scx_lavd

RUN /binary-build/stage.sh --out /out --env /upstream.env --src /src \
        --bin target/release/scx_rusty:bin/scx_rusty --bin target/release/scx_lavd:bin/scx_lavd \
        --license LICENSE:scx-LICENSE \
        --license scheds/rust/scx_rusty/LICENSE:scx_rusty-LICENSE \
        --license scheds/rust/scx_lavd/LICENSE:scx_lavd-LICENSE \
        --smoke bin/scx_rusty:--version --smoke bin/scx_lavd:--version

FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY --from=build /out/ /

LABEL maintainer="redcodeworks/fedora-toolbox" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="scx-bin" \
      org.opencontainers.image.description="scx_rusty and scx_lavd sched_ext schedulers built from a pinned upstream release" \
      org.opencontainers.image.url="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.documentation="https://github.com/redcodeworks/fedora-toolbox/blob/main/scx-bin/README.md" \
      org.opencontainers.image.source="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.licenses="GPL-2.0-only" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
