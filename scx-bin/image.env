# Binary image, not a toolbox: FROM scratch, binaries built from the pinned upstream release (see README.md).
IMAGE_NAME=scx-bin
IMAGE_DESC="scx_rusty and scx_lavd sched_ext schedulers built from a pinned upstream release"
IMAGE_KIND=binary
# The shared build scripts live in binary-build/ (a change there rebuilds every binary image).
BUILD_CONTEXT=.
EXTRA_PATHS=binary-build
# The schedulers it carries are the lines of scx-bin/schedulers.txt (the build step checks /bin/<name> for each, plus
# /SOURCE, /BUILDINFO and /LICENSES).
# Rebuilt only when upstream.env or the build files change, never by the weekly schedule.
IMAGE_SCHEDULE=false
