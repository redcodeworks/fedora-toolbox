# Optional per-image metadata. The image name defaults to the directory name; IMAGE_NAME overrides it.
# The published image is ghcr.io/<owner>/<IMAGE_NAME> (the host recipe depends on this path).
IMAGE_NAME=fedora-toolbox
IMAGE_DESC="Fedora development toolbox for distrobox with a shared home"
# The build context is the repository root (the shared list lives in dev-packages/, the installer in
# package-installer/); a change there rebuilds this image.
BUILD_CONTEXT=.
EXTRA_PATHS=dev-packages package-installer
