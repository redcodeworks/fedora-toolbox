# Data image, not a toolbox: FROM scratch, the package list and its installer (see README.md).
IMAGE_NAME=dev-packages
IMAGE_DESC="Developer package list and installer shared by dev-toolbox and octarine-os-dx"
IMAGE_KIND=list
# The weekly schedule does not rebuild it (a rebuild only changes the created label, so the digest
# consumers pin would change for no reason); changes and manual runs do.
IMAGE_SCHEDULE=false
