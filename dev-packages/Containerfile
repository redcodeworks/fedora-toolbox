# Published as ghcr.io/redcodeworks/dev-packages: the developer package list and its installer,
# nothing else. No base image, no shell, no packages (this is data, not a toolbox). The installer is the shared
# package-installer/install.sh. Build context: the repository root (BUILD_CONTEXT=. in image.env).
# Consumers copy or bind-mount it into their own build; see README.md.
FROM scratch

# Build values passed by CI (podman build --build-arg ...); no secrets
ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown

COPY dev-packages/dev.txt package-installer/install.sh /
COPY dev-packages/README.md /README

LABEL maintainer="redcodeworks/fedora-toolbox" \
      org.opencontainers.image.authors="redcodeworks" \
      org.opencontainers.image.vendor="redcodeworks" \
      org.opencontainers.image.title="dev-packages" \
      org.opencontainers.image.description="Developer package list and installer shared by dev-toolbox and octarine-os-dx" \
      org.opencontainers.image.url="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.documentation="https://github.com/redcodeworks/fedora-toolbox/blob/main/dev-packages/README.md" \
      org.opencontainers.image.source="https://github.com/redcodeworks/fedora-toolbox" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
